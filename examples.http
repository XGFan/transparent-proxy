@host = http://192.168.2.1:1444
# config.yaml 里 api_key 非空时，所有 /api/* 都需要该头；留空则不鉴权。
@apiKey = changeme

### status：代理状态 + checker 状态 + 所有 set 内容
GET {{host}}/api/status
X-Api-Key: {{apiKey}}

### ip：返回请求方 IP（可用 ?ip= 覆盖）
GET {{host}}/api/ip
X-Api-Key: {{apiKey}}

### config：读全局配置（proxy + checker + chnroute，不含 api_key）
GET {{host}}/api/config
X-Api-Key: {{apiKey}}

### config：写全局配置（未列出的字段会被覆盖为零值，先 GET 再整体回写）
PUT {{host}}/api/config
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "listen": ":1444",
  "proxy": {
    "lan_interface": "br-lan",
    "default_port": 1081,
    "forced_port": 1082,
    "self_mark": 255
  },
  "checker": {
    "enabled": true,
    "method": "HEAD",
    "url": "http://www.qq.com",
    "timeout": "10s",
    "interval": "30s",
    "failure_threshold": 3,
    "on_failure": "disable"
  },
  "chnroute": {
    "auto_refresh": true,
    "refresh_interval": "168h"
  }
}

### checker：读健康检查配置与运行状态
GET {{host}}/api/checker
X-Api-Key: {{apiKey}}

### checker：写健康检查配置（on_failure 保持原值，不接受该字段）
PUT {{host}}/api/checker
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "enabled": true,
  "method": "HEAD",
  "url": "http://www.qq.com",
  "host": "",
  "timeout": "10s",
  "interval": "30s",
  "failure_threshold": 3
}

### proxy：切换透明代理开关
PUT {{host}}/api/proxy
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "enabled": true
}

### rules：列出所有 set 内容
GET {{host}}/api/rules
X-Api-Key: {{apiKey}}

### rules：向 set 添加元素（IP / CIDR / 区间）
POST {{host}}/api/rules/add
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "ip": "1.2.3.4",
  "set": "proxy_src"
}

### rules：从 set 删除元素
POST {{host}}/api/rules/remove
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "ip": "1.2.3.4",
  "set": "proxy_src"
}

### rules：把所有 set 持久化到 state_path/*.nft
# 无 body 也要带 Content-Type：写方法一律要求 application/json（挡跨站简单请求）
POST {{host}}/api/rules/sync
Content-Type: application/json
X-Api-Key: {{apiKey}}

### refresh-route：立即刷新 chnroute
POST {{host}}/api/refresh-route
Content-Type: application/json
X-Api-Key: {{apiKey}}

### panel.js：面板 bundle（不鉴权，net-console 用它探活）
GET {{host}}/panel.js

### 统一响应 envelope
# {
#   "code": "ok|invalid_request|unauthorized|internal_error",
#   "message": "...",
#   "data": { ... }
# }
